{
	"name": "@rshval/svelte-components",
	"version": "1.4.5",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test:browser": "node ./scripts/run-vitest-browser.mjs --run",
		"test": "npm run test:unit -- --run",
		"check:deps": "node ./scripts/check-import-deps.mjs",
		"storybook": "storybook dev -p 6006 --ci --disable-telemetry",
		"build-storybook": "storybook build --disable-telemetry",
		"changeset": "changeset",
		"version:packages": "changeset version",
		"release": "npm version patch && npm publish && git push --follow-tags",
		"smoke:exports": "node ./scripts/smoke-exports.mjs",
		"smoke:consumer": "node ./scripts/smoke-consumer-build.mjs",
		"smoke:consumer:ssr": "node ./scripts/smoke-consumer-ssr.mjs",
		"smoke:consumer:dev-ssr": "node ./scripts/smoke-consumer-dev-ssr.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./helpers": {
			"types": "./dist/helpers/index.d.ts",
			"default": "./dist/helpers/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"default": "./dist/plugins/index.js"
		},
		"./stores": {
			"types": "./dist/stores/index.d.ts",
			"default": "./dist/stores/index.js"
		},
		"./constants": {
			"types": "./dist/constants.d.ts",
			"default": "./dist/constants.js"
		},
		"./network": {
			"types": "./dist/network/index.d.ts",
			"default": "./dist/network/index.js"
		},
		"./network/socket-io": {
			"types": "./dist/network/socket-io.d.ts",
			"default": "./dist/network/socket-io.js"
		}
	},
	"peerDependencies": {
		"@tiptap/core": "^3.30.0",
		"@tiptap/extension-bubble-menu": "^3.30.0",
		"@tiptap/extension-underline": "^3.30.0",
		"@tiptap/starter-kit": "^3.30.0",
		"svelte": "^5.56.4"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.5.7",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/sveltekit": "^10.5.7",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@tiptap/core": "^3.27.1",
		"@tiptap/extension-bubble-menu": "^3.27.1",
		"@tiptap/extension-underline": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"@vitest/browser": "4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"daisyui": "^5.7.16",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.11.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.23",
		"storybook": "^10.5.7",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"description": "Reusable Svelte 5 UI component library (forms, table, map, notifications, drawers and stores).",
	"license": "MIT",
	"dependencies": {
		"@capacitor-mlkit/barcode-scanning": "^8.1.0",
		"@capacitor/core": "^8.5.0",
		"@capacitor/device": "^8.0.3",
		"@capacitor/geolocation": "^8.2.1",
		"@capacitor/network": "^8.0.1",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/screen-orientation": "^8.0.1",
		"@capacitor/status-bar": "^8.0.3",
		"@popperjs/core": "^2.11.8",
		"@svelte-put/dragscroll": "^4.0.0",
		"@tabler/icons-svelte-runes": "^3.46.0",
		"@turf/turf": "^7.4.0",
		"@zxing/browser": "^0.2.1",
		"delay": "^7.0.0",
		"dompurify": "^3.4.13",
		"esm-env": "^1.2.2",
		"libphonenumber-js": "^1.13.10",
		"mapbox-gl": "^3.28.1",
		"socket.io-client": "^4.8.1",
		"uniqolor": "^1.1.1"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"components",
		"ui",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rshval/svelte-components.git"
	},
	"homepage": "https://github.com/rshval/svelte-components#readme",
	"bugs": {
		"url": "https://github.com/rshval/svelte-components/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=20.0.0"
	}
}
